<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.Purpose" table="purpose">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.PurposePK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="acousticCategory" column="AcousticCategory" type="int"/>
      </composite-id>

      <property name="purpose" column="Purpose" type="short" not-null="true"/>

      <!-- Associations -->

      <many-to-one
            name="survey"
            class="no.imr.lsss.database.tables.hibernate.Survey"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="Survey"/>
      </many-to-one>

      <many-to-one
            name="acousticCategory"
            class="no.imr.lsss.database.tables.hibernate.AcousticCategory"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="AcousticCategory"/>
      </many-to-one>

   </class>
</hibernate-mapping>
