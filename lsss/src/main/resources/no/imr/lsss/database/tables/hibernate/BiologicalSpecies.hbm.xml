<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.BiologicalSpecies" table="BiologicalSpecies">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.BiologicalSpeciesPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="biologicalSpecies" column="BiologicalSpecies" type="int"/>
      </composite-id>

      <property name="initials" column="Initials" type="java.lang.String" length="5"/>
      <property name="commonName" column="CommonName" type="java.lang.String" length="80"/>
      <property name="englishName" column="EnglishName" type="java.lang.String" length="80"/>
      <property name="latinName" column="LatinName" type="java.lang.String" length="80"/>
      <property name="nodc" column="NODC" type="java.lang.String" length="12"/>
      <property name="itis" column="ITIS" type="int" not-null="true"/>

      <!-- Associations -->
      <many-to-one
            name="nation"
            class="no.imr.lsss.database.tables.hibernate.Nation"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
      </many-to-one>

      <set
            name="acousticCategoryToBiologicalSpecies"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="BiologicalSpecies"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AcCatToBiologicalSpecies"
         />
      </set>

   </class>
</hibernate-mapping>
