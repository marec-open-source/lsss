<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.SchoolMorphology" table="schoolmorphology">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.SchoolMorphologyPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="object" column="Object" type="int"/>
         <key-property name="schoolObjectType" column="schoolobjecttype" type="short"/>
      </composite-id>

      <property name="observationDate" column="observationdate" type="int" not-null="true"/>
      <property name="observationTime" column="observationtime" type="int" not-null="true"/>
      <property name="boxDuration" column="boxduration" type="int" not-null="true"/>
      <property name="boxThickness" column="boxthickness" type="float" not-null="true"/>
      <property name="boxLength" column="boxlength" type="float" not-null="true"/>
      <property name="maxThickness" column="maxthickness" type="float" not-null="true"/>
      <property name="maxLength" column="maxlength" type="float" not-null="true"/>
      <property name="perimeter" column="perimeter" type="float" not-null="true"/>
      <property name="area" column="area" type="float" not-null="true"/>
      <property name="roughness" column="roughness" type="float" not-null="true"/>
      <property name="circularity" column="circularity" type="float" not-null="true"/>
      <property name="rectangularity" column="rectangularity" type="float" not-null="true"/>
      <property name="elongation" column="elongation" type="float" not-null="true"/>
      <property name="distanceToBottom" column="distanceToBottom" type="float" not-null="true"/>
      <property name="distanceToSurface" column="distanceToSurface" type="float" not-null="true"/>
      <property name="bottomDepth" column="bottomdepth" type="float" not-null="true"/>
      <property name="nmbAcousticCat" column="nmbacousticcat" type="int" not-null="true"/>
      <property name="nmbHoles" column="nmbholes" type="int" not-null="true"/>
      <property name="nmbKernels" column="nmbkernels" type="int" not-null="true"/>

      <!-- Associations -->

      <many-to-one
            name="scatterObject"
            class="no.imr.lsss.database.tables.hibernate.ScatterObject"
            not-null="true"
            insert="false"
            update="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="Survey"/>
         <column name="Object"/>
      </many-to-one>

      <many-to-one
            name="schoolObjectType"
            class="no.imr.lsss.database.tables.hibernate.SchoolObjectType"
            not-null="true"
            insert="false"
            update="false"
      >
         <column name="SchoolObjectType"/>
      </many-to-one>

      <set
            name="schoolData"
            lazy="true"
            inverse="true"
            cascade="all,delete-orphan"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="Object"/>
            <column name="SchoolObjectType"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.SchoolData"
         />
      </set>

   </class>
</hibernate-mapping>
