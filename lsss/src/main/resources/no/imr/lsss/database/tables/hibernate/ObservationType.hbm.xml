<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.ObservationType" table="ObservationType">
      <id name="observationType" column="ObservationType" type="short"/>

      <property name="observationTypeName" column="ObservationTypeName" type="java.lang.String" length="80"/>

      <!-- Associations -->

      <set
            name="observations"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="ObservationType"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Observation"
         />
      </set>

   </class>
</hibernate-mapping>
