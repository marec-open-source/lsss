<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.StandardComment" table="StandardComment">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.StandardCommentPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="standardComment" column="StandardComment" type="int"/>
      </composite-id>

      <property name="text" column="Text" type="java.lang.String" length="200"/>

      <!-- Associations -->

      <many-to-one
            name="platform"
            class="no.imr.lsss.database.tables.hibernate.Platform"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
      </many-to-one>

   </class>
</hibernate-mapping>
