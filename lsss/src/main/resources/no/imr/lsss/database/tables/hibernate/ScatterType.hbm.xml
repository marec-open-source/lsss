<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.ScatterType" table="ScatterType">
      <id name="scatterType" column="ScatterType" type="short"/>

      <property name="scatterTypeName" column="ScatterTypeName" type="java.lang.String" length="40"/>

      <!-- Associations -->

      <set
            name="scatters"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="ScatterType"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Scatter"
         />
      </set>

   </class>
</hibernate-mapping>
