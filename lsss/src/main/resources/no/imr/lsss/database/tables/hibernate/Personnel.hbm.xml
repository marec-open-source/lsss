<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.Personnel" table="personnel">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.PersonnelPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="person" column="Person" type="java.lang.String" length="80"/>
      </composite-id>

      <!-- Associations -->

      <many-to-one
            name="survey"
            class="no.imr.lsss.database.tables.hibernate.Survey"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="Survey"/>
      </many-to-one>

   </class>
</hibernate-mapping>
