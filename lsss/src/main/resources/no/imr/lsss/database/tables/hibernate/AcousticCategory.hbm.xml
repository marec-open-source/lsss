<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.AcousticCategory" table="AcousticCategory">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.AcousticCategoryPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="acousticCategory" column="AcousticCategory" type="int"/>
      </composite-id>

      <property name="composite" column="Composite" type="short" not-null="true"/>
      <property name="initials" column="Initials" type="java.lang.String" length="5"/>
      <property name="englishInitials" column="EnglishInitials" type="java.lang.String" length="5"/>
      <property name="commonName" column="CommonName" type="java.lang.String" length="80"/>
      <property name="englishName" column="EnglishName" type="java.lang.String" length="80"/>

      <!-- Associations -->

      <many-to-one
            name="platform"
            class="no.imr.lsss.database.tables.hibernate.Platform"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
      </many-to-one>

      <set
            name="areaOfAcousticCategory"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategory"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AreaOfAcousticCategory"
         />
      </set>

      <set
            name="acousticCategoryCompositesByNationAndPlatformAndAcousticCategoryMember"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategoryMember"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AcousticCategoryComposite"
         />
      </set>

      <set
            name="acousticCategoryCompositesByNationAndPlatformAndAcousticCategory"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategory"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AcousticCategoryComposite"
         />
      </set>

      <set
            name="scatterData"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategory"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.ScatterData"
         />
      </set>

      <set
            name="purpose"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategory"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Purpose"
         />
      </set>

      <set
            name="acousticCategoryToBiologicalSpecies"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="AcousticCategory"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AcCatToBiologicalSpecies"
         />
      </set>

   </class>
</hibernate-mapping>
