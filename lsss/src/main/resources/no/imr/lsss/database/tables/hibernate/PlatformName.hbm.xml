<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.PlatformName" table="PlatformName">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.PlatformNamePK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="firstValidDate" column="FirstValidDate" type="int"/>
      </composite-id>

      <property name="lastValidDate" column="LastValidDate" type="int" not-null="true"/>
      <property name="platformName" column="PlatformName" type="java.lang.String" length="80"/>

      <!-- Associations -->

      <many-to-one
            name="platform"
            class="no.imr.lsss.database.tables.hibernate.Platform"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
      </many-to-one>

   </class>
</hibernate-mapping>
