<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.ScatterObject" table="scatterobject">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.ScatterObjectPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="object" column="Object" type="int"/>
      </composite-id>

      <property name="observationDate" column="observationdate" type="int" not-null="true"/>
      <property name="observationTime" column="observationtime" type="int" not-null="true"/>
      <property name="observationType" column="observationtype" type="short" not-null="true"/>
      <property name="duration" column="duration" type="int" not-null="true"/>

      <!-- Associations -->

      <many-to-one
            name="observation"
            class="no.imr.lsss.database.tables.hibernate.Observation"
            not-null="true"
            insert="false"
            update="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="Survey"/>
         <column name="ObservationDate"/>
         <column name="ObservationTime"/>
         <column name="ObservationType"/>
      </many-to-one>

      <set
            name="schoolCategories"
            lazy="true"
            inverse="true"
            cascade="all,delete-orphan"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="Object"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.SchoolCategory"
         />
      </set>

      <set
            name="scatters"
            lazy="true"
            inverse="true"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="Object"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Scatter"
         />
      </set>

      <set
            name="schoolMorphologies"
            lazy="true"
            inverse="true"
            cascade="all,delete-orphan"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="Object"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.SchoolMorphology"
         />
      </set>

      <one-to-one
            name="schoolDetect"
            class="no.imr.lsss.database.tables.hibernate.SchoolDetect"
            cascade="all"
      >
      </one-to-one>

   </class>
</hibernate-mapping>
