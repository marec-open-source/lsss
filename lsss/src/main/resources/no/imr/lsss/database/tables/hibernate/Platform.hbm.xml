<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.Platform" table="platform">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.PlatformPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
      </composite-id>

      <property name="platformType" column="PlatformType" type="short" not-null="true"/>
      <property name="platformSubType" column="PlatformSubType" type="short" not-null="true"/>
      <property name="firstValidDate" column="FirstValidDate" type="int" not-null="true"/>
      <property name="lastValidDate" column="LastValidDate" type="int" not-null="true"/>

      <!-- Associations -->

      <many-to-one
            name="nation"
            class="no.imr.lsss.database.tables.hibernate.Nation"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
      </many-to-one>

      <set
            name="acousticCategories"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.AcousticCategory"
         />
      </set>

      <set
            name="surveys"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Survey"
         />
      </set>

      <set
            name="platformNames"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.PlatformName"
         />
      </set>

      <set
            name="platformCodes"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.PlatformCodes"
         />
      </set>

   </class>
</hibernate-mapping>
