<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.Observation" table="observation">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.ObservationPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="observationDate" column="ObservationDate" type="int"/>
         <key-property name="observationTime" column="ObservationTime" type="int"/>
         <key-property name="observationType" column="ObservationType" type="short"/>
      </composite-id>

      <property name="distance" column="Distance" type="float" not-null="true"/>
      <property name="latitude" column="Latitude" type="float" not-null="true"/>
      <property name="longitude" column="Longitude" type="float" not-null="true"/>
      <property name="bottomDepth" column="BottomDepth" type="float" not-null="true"/>

      <!-- Associations -->

      <many-to-one
            name="survey"
            class="no.imr.lsss.database.tables.hibernate.Survey"
            update="false"
            insert="false"
      >
         <column name="Nation"/>
         <column name="Platform"/>
         <column name="Survey"/>
      </many-to-one>

      <many-to-one
            name="observationType"
            class="no.imr.lsss.database.tables.hibernate.ObservationType"
            update="false"
            insert="false"
      >
         <column name="ObservationType"/>
      </many-to-one>

      <one-to-one
            name="observationComment"
            class="no.imr.lsss.database.tables.hibernate.ObservationComment"
            outer-join="auto"
      >
      </one-to-one>

      <set
            name="scatters"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="ObservationDate"/>
            <column name="ObservationTime"/>
            <column name="ObservationType"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Scatter"
         />
      </set>

      <set
            name="scatterObjects"
            lazy="true"
            inverse="true"
      >
         <key>
            <column name="Nation"/>
            <column name="Platform"/>
            <column name="Survey"/>
            <column name="ObservationDate"/>
            <column name="ObservationTime"/>
            <column name="ObservationType"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.ScatterObject"
         />
      </set>

   </class>
</hibernate-mapping>
