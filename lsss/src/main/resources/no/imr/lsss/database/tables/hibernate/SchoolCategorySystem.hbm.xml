<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.SchoolCategorySystem" table="schoolcategorysystem">
      <id name="categorySystem" column="categorysystem" type="short"/>

      <property name="categorySystemName" column="categorysystemname" type="java.lang.String" length="40"/>
      <property name="categorySystemDescription" column="categorysystemdescription" type="java.lang.String" length="40"/>
   </class>
</hibernate-mapping>
