<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.Nation" table="nation">
      <id name="nation" column="Nation" type="short"/>

      <property name="nationName" column="NationName" type="java.lang.String" length="80"/>

      <!-- Associations -->

      <set
            name="platforms"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.Platform"
         />
      </set>

      <set
            name="biologicalSpecies"
            lazy="true"
            inverse="true"
            cascade="none"
      >
         <key>
            <column name="Nation"/>
         </key>
         <one-to-many
               class="no.imr.lsss.database.tables.hibernate.BiologicalSpecies"
         />
      </set>
   </class>
</hibernate-mapping>
