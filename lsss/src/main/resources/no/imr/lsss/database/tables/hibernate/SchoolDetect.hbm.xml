<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
      "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
      "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
   <class name="no.imr.lsss.database.tables.hibernate.SchoolDetect" table="schooldetect">
      <composite-id name="compId" class="no.imr.lsss.database.tables.hibernate.ScatterObjectPK">
         <key-property name="nation" column="Nation" type="short"/>
         <key-property name="platform" column="Platform" type="short"/>
         <key-property name="survey" column="Survey" type="int"/>
         <key-property name="object" column="Object" type="int"/>
      </composite-id>

      <property name="detectionThreshold" column="detectionthreshold" type="float" not-null="true"/>
      <property name="detectionThresholdHole" column="detectionthresholdhole" type="float" not-null="true"/>
      <property name="minSizeHole" column="minsizehole" type="float" not-null="true"/>
      <property name="smoothVertical" column="smoothvertical" type="float" not-null="true"/>
      <property name="smoothHorizontal" column="smoothhorizontal" type="float" not-null="true"/>
      <property name="detectionSettings" column="detectionsettings" type="java.lang.String" length="1024"/>
      <property name="manuallyCorrected" column="manuallycorrected" type="short" not-null="true"/>

      <!-- Associations -->

      <one-to-one
            name="scatterObject"
            class="no.imr.lsss.database.tables.hibernate.ScatterObject"
            constrained="true"
      >
      </one-to-one>

   </class>
</hibernate-mapping>
